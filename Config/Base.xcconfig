// Shared build settings for the app and the widget. Personal signing lives in
// Signing.xcconfig (gitignored; copy Signing.example.xcconfig). Without it the
// project still builds, unsigned, which is what the hooks and CI do.

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES

BUNDLE_ID_PREFIX = io.github.dewab74
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

#include? "Signing.xcconfig"

// App Group shared by the app and the widget. On macOS a group named
// "<team id>.<anything>" needs no registration in the developer portal.
KUMA_APP_GROUP = $(TeamIdentifierPrefix)$(BUNDLE_ID_PREFIX).KumaStatus
