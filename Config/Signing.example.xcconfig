// Copy to Config/Signing.xcconfig (gitignored) and fill in your team id, the
// 10-character "OU" of your "Apple Development" certificate:
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
// A free personal team works. Change BUNDLE_ID_PREFIX if you fork the project.

DEVELOPMENT_TEAM = ABCDE12345
